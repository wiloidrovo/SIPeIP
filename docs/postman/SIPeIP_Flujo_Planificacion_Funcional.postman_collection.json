            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login de planificador correcto', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.usuario.username).to.eql(pm.collectionVariables.get('planificador_username'));",
                  "pm.collectionVariables.set('planificador_id', String(body.usuario.id));",
                  "pm.collectionVariables.set('entidad_planificador_id', String(body.usuario.institucion.id));"
