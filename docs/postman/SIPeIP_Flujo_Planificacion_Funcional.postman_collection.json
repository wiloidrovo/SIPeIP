              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('La API exige autenticación', () => pm.response.to.have.status(401));",
                  "pm.test('El error es JSON controlado', () => pm.expect(pm.response.json().code).to.eql('not_authenticated'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/planes/"
          }
        },
