        {
          "name": "07 - Localizar objetivo PND de referencia",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Catálogo PND disponible', () => pm.response.to.have.status(200));",
                  "const payload = pm.response.json();",
                  "const rows = Array.isArray(payload) ? payload : (payload.results || []);",
                  "const item = rows.find(row => row.codigo === 'PND-REF-01');",
                  "pm.expect(item, 'Debe existir PND-REF-01').to.be.an('object');",
                  "pm.collectionVariables.set('objetivo_pnd_id', String(item.id));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/objetivos-pnd/?search=PND-REF-01&estado=ACTIVO"
          }
        },
        {
          "name": "08 - Localizar ODS 16 de referencia",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Catálogo ODS disponible', () => pm.response.to.have.status(200));",
                  "const payload = pm.response.json();",
                  "const rows = Array.isArray(payload) ? payload : (payload.results || []);",
                  "const item = rows.find(row => Number(row.numero) === 16);",
                  "pm.expect(item, 'Debe existir el ODS 16 de referencia').to.be.an('object');",
                  "pm.collectionVariables.set('ods_id', String(item.id));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/ods/?search=16&estado=ACTIVO"
          }
        }
      ]
