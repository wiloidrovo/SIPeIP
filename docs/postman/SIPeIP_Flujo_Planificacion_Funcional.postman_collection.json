{
  "info": {
    "_postman_id": "5eb534e7-5b9c-4d71-9b86-cf8cc778ec23",
    "name": "SIPeIP - Flujo funcional de planificación",
    "description": "Caso funcional secuencial: un planificador construye un único expediente, comprueba el bloqueo de un envío incompleto, lo envía, un supervisor consulta todo su contenido y sus ODS, valida y aprueba, y finalmente se registra y consulta el seguimiento. Requiere los datos locales creados por inicializar_sistema. Complete únicamente la variable password antes de ejecutar la colección en orden. La contraseña no se guarda en este archivo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Sesión real del planificador",
      "item": [
        {
          "name": "01 - Preparar CSRF para cerrar cualquier sesión previa",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const now = new Date();",
                  "pm.collectionVariables.set('run_id', String(now.getTime()));",
                  "pm.collectionVariables.set('fecha_avance', now.toISOString().slice(0, 10));",
                  "pm.collectionVariables.set('fecha_inicio', new Date(Date.UTC(now.getUTCFullYear(), 0, 1)).toISOString().slice(0, 10));",
                  "pm.collectionVariables.set('fecha_fin', new Date(Date.UTC(now.getUTCFullYear() + 1, 11, 31)).toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CSRF preparado', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('csrf_token', pm.response.json().csrf_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/auth/csrf/"
          }
        },
        {
          "name": "02 - Cerrar sesión previa si existe",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('La sesión previa quedó cerrada o no existía', () => pm.expect([200, 401]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRFToken",
                "value": "{{csrf_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/auth/logout/"
          }
